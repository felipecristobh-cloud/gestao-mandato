# Banco PostgreSQL
DATABASE_URL="postgresql://gestao:gestao@localhost:5432/gestao?schema=public"
# Banco usado pelos testes de integração (é apagado e recriado a cada execução)
DATABASE_URL_TEST="postgresql://gestao:gestao@localhost:5432/gestao_test?schema=public"
# Senha inicial dos usuários fictícios do seed (somente desenvolvimento/homologação)
SEED_SENHA="Trocar@123"

# --- Documentos ---
# Chave AES-256 dos anexos (obrigatória em produção): openssl rand -base64 32. Guarde fora do backup.
# DOCUMENTOS_CHAVE=""
# Disco local (padrão .dados/documentos). Em produção, use o Supabase Storage abaixo.
# DOCUMENTOS_DIR=""
# Supabase Storage (bucket privado). A service_role só fica no servidor, nunca em NEXT_PUBLIC_.
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# DOCUMENTOS_BUCKET="documentos"
# Limite de upload em MB (máx. 10). Na Vercel use 4 (corpo de requisição até 4,5 MB).
# NEXT_PUBLIC_DOCUMENTOS_MAX_MB="4"

# --- Produção (Supabase) ---
# DATABASE_URL = pooler de transação (porta 6543) com ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = pooler de sessão (porta 5432), usado só para migrations no build
# DIRECT_URL=""

# --- Login com Google (opcional) ---
# Sem as duas chaves, o botão "Entrar com Google" não aparece.
# Redirect autorizado no Google: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"
