generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  COORDENACAO
  ASSESSOR
  CONSULTA
}

enum AcaoAuditoria {
  CRIAR
  EDITAR
  EXCLUIR
  VISUALIZAR_SENSIVEL
  EXPORTAR
  LOGIN
  LOGIN_FALHA
  LOGOUT
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  nome             String
  email            String    @unique
  telefone         String?
  cargo            String?
  perfil           Perfil    @default(CONSULTA)
  ativo            Boolean   @default(true)
  senhaHash        String    @map("senha_hash")
  trocarSenha      Boolean   @default(true) @map("trocar_senha")
  tentativasFalhas Int       @default(0) @map("tentativas_falhas")
  bloqueadoAte     DateTime? @map("bloqueado_ate")
  ultimoLogin      DateTime? @map("ultimo_login")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  sessoes   Sessao[]
  auditoria AuditLog[]

  demandasResponsavel  Demanda[]          @relation("DemandaResponsavel")
  demandasCriadas      Demanda[]          @relation("DemandaCriadoPor")
  pessoasCriadas       Pessoa[]
  historicoDemandas    DemandaHistorico[]
  encaminhamentos      Encaminhamento[]
  parlamentaresCriados Parlamentar[]
  mandatosCriados      Mandato[]
  vinculosMandato      DemandaMandato[]

  @@map("usuario")
}

model Sessao {
  id        String   @id
  usuarioId String   @map("usuario_id") @db.Uuid
  expiraEm  DateTime @map("expira_em")
  criadoEm  DateTime @default(now()) @map("criado_em")
  ip        String?
  userAgent String?  @map("user_agent")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessao")
}

model Regional {
  id     Int    @id @default(autoincrement())
  nome   String @unique
  codigo String @unique

  bairros Bairro[]

  @@map("regional")
}

enum Esfera {
  MUNICIPAL
  ESTADUAL
  FEDERAL
}

enum StatusDemanda {
  NOVA
  EM_ANALISE
  ENCAMINHADA
  AGUARDANDO_RETORNO
  EM_ANDAMENTO
  RESOLVIDA
  NAO_RESOLVIDA
  CANCELADA
}

enum TipoDemanda {
  SOLICITACAO
  RECLAMACAO
  DENUNCIA
  SUGESTAO
  PEDIDO_INFORMACAO
  OUTRO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoHistorico {
  CRIACAO
  EDICAO
  STATUS
  RESPONSAVEL
  ENCAMINHAMENTO
  RETORNO
  COMENTARIO
  ARTICULACAO
}

model Bairro {
  id         Int    @id @default(autoincrement())
  nome       String
  regionalId Int    @map("regional_id")

  regional Regional  @relation(fields: [regionalId], references: [id])
  pessoas  Pessoa[]
  demandas Demanda[]

  @@unique([nome, regionalId])
  @@map("bairro")
}

model Tema {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)

  demandas Demanda[]

  @@map("tema")
}

model Orgao {
  id      Int     @id @default(autoincrement())
  nome    String  @unique
  sigla   String?
  esfera  Esfera  @default(MUNICIPAL)
  contato String?
  ativo   Boolean @default(true)

  demandas        Demanda[]
  encaminhamentos Encaminhamento[]

  @@map("orgao")
}

/// Cidadão solicitante. Dado pessoal (LGPD): contato só aparece para quem pode ver.
model Pessoa {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  telefone     String?
  email        String?
  endereco     String?
  bairroId     Int?     @map("bairro_id")
  criadoPorId  String?  @map("criado_por_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  bairro    Bairro?   @relation(fields: [bairroId], references: [id])
  criadoPor Usuario?  @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  demandas  Demanda[]

  @@index([telefone])
  @@map("pessoa")
}

/// Contador de protocolo por ano (DEM-2026-00001).
model ProtocoloSeq {
  ano    Int @id
  ultimo Int

  @@map("protocolo_seq")
}

model Demanda {
  id            String        @id @default(uuid()) @db.Uuid
  protocolo     String        @unique
  pessoaId      String        @map("pessoa_id") @db.Uuid
  endereco      String?
  bairroId      Int?          @map("bairro_id")
  temaId        Int           @map("tema_id")
  tipo          TipoDemanda   @default(SOLICITACAO)
  descricao     String
  prioridade    Prioridade    @default(MEDIA)
  status        StatusDemanda @default(NOVA)
  prazo         DateTime?     @db.Date
  responsavelId String?       @map("responsavel_id") @db.Uuid
  orgaoId       Int?          @map("orgao_id")
  dataEntrada   DateTime      @default(now()) @map("data_entrada") @db.Date
  dataConclusao DateTime?     @map("data_conclusao") @db.Date
  observacoes   String?
  criadoPorId   String?       @map("criado_por_id") @db.Uuid
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")

  pessoa          Pessoa             @relation(fields: [pessoaId], references: [id])
  bairro          Bairro?            @relation(fields: [bairroId], references: [id])
  tema            Tema               @relation(fields: [temaId], references: [id])
  orgao           Orgao?             @relation(fields: [orgaoId], references: [id])
  responsavel     Usuario?           @relation("DemandaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPor       Usuario?           @relation("DemandaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  historico       DemandaHistorico[]
  encaminhamentos Encaminhamento[]
  mandatos        DemandaMandato[]

  @@index([status])
  @@index([prazo])
  @@index([responsavelId])
  @@index([bairroId])
  @@index([temaId])
  @@map("demanda")
}

model DemandaHistorico {
  id             String         @id @default(uuid()) @db.Uuid
  demandaId      String         @map("demanda_id") @db.Uuid
  usuarioId      String?        @map("usuario_id") @db.Uuid
  data           DateTime       @default(now())
  tipo           TipoHistorico
  statusAnterior StatusDemanda? @map("status_anterior")
  statusNovo     StatusDemanda? @map("status_novo")
  descricao      String

  demanda Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([demandaId, data])
  @@map("demanda_historico")
}

model Encaminhamento {
  id           String    @id @default(uuid()) @db.Uuid
  demandaId    String    @map("demanda_id") @db.Uuid
  orgaoId      Int       @map("orgao_id")
  usuarioId    String?   @map("usuario_id") @db.Uuid
  data         DateTime  @default(now()) @db.Date
  protocolo    String?
  descricao    String
  prazoRetorno DateTime? @map("prazo_retorno") @db.Date
  retorno      String?
  dataRetorno  DateTime? @map("data_retorno") @db.Date
  criadoEm     DateTime  @default(now()) @map("criado_em")

  demanda Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  orgao   Orgao    @relation(fields: [orgaoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([demandaId])
  @@map("encaminhamento")
}

model AuditLog {
  id            String        @id @default(uuid()) @db.Uuid
  usuarioId     String?       @map("usuario_id") @db.Uuid
  data          DateTime      @default(now())
  entidade      String
  registroId    String?       @map("registro_id")
  acao          AcaoAuditoria
  valorAnterior Json?         @map("valor_anterior")
  valorNovo     Json?         @map("valor_novo")
  descricao     String?
  ip            String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, registroId])
  @@index([data])
  @@map("audit_log")
}

enum CargoParlamentar {
  VEREADOR
  DEPUTADO_ESTADUAL
  DEPUTADO_FEDERAL
  SENADOR
  OUTRO
}

/// Participação de um mandato numa demanda (e, na Fase 4, numa emenda). Autoria só existe quando cadastrada explicitamente.
enum TipoParticipacao {
  AUTOR
  COAUTOR
  ARTICULADOR
  PARCEIRO
  ACOMPANHAMENTO
  EXECUCAO
  INTERMEDIARIO
}

/// Agente político (dado público). `proprio` marca o titular do gabinete (só um).
model Parlamentar {
  id           String           @id @default(uuid()) @db.Uuid
  nome         String
  cargo        CargoParlamentar
  partido      String?
  esfera       Esfera
  municipio    String?
  uf           String?          @db.Char(2)
  telefone     String?
  email        String?
  observacoes  String?
  proprio      Boolean          @default(false)
  ativo        Boolean          @default(true)
  criadoPorId  String?          @map("criado_por_id") @db.Uuid
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @updatedAt @map("atualizado_em")

  criadoPor Usuario?  @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  mandatos  Mandato[]

  @@index([nome])
  @@map("parlamentar")
}

/// Um período de mandato. Uma pessoa pode ter vários, inclusive em cargos diferentes.
model Mandato {
  id            String           @id @default(uuid()) @db.Uuid
  parlamentarId String           @map("parlamentar_id") @db.Uuid
  cargo         CargoParlamentar
  esfera        Esfera
  legislatura   String?
  descricao     String?
  partido       String?
  municipio     String?
  uf            String?          @db.Char(2)
  dataInicio    DateTime         @map("data_inicio") @db.Date
  dataFim       DateTime?        @map("data_fim") @db.Date
  observacoes   String?
  criadoPorId   String?          @map("criado_por_id") @db.Uuid
  criadoEm      DateTime         @default(now()) @map("criado_em")
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em")

  parlamentar Parlamentar      @relation(fields: [parlamentarId], references: [id], onDelete: Restrict)
  criadoPor   Usuario?         @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  demandas    DemandaMandato[]

  @@index([parlamentarId])
  @@map("mandato")
}

model DemandaMandato {
  id          String           @id @default(uuid()) @db.Uuid
  demandaId   String           @map("demanda_id") @db.Uuid
  mandatoId   String           @map("mandato_id") @db.Uuid
  tipo        TipoParticipacao
  observacoes String?
  usuarioId   String?          @map("usuario_id") @db.Uuid
  criadoEm    DateTime         @default(now()) @map("criado_em")

  demanda Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  mandato Mandato  @relation(fields: [mandatoId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([demandaId, mandatoId, tipo])
  @@index([mandatoId])
  @@map("demanda_mandato")
}
